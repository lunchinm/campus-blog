{
  "designSystem": "action-buttons",
  "version": "1.0.0",
  "description": "点赞、评论、收藏按钮的 UI 设计规范",
  "source": "ArticleDetail.vue",
  "buttons": [
    {
      "type": "comment",
      "name": "评论按钮",
      "tooltip": "评论",
      "icon": {
        "type": "svg",
        "svg": "<svg stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\" height=\"44\" width=\"44\" xmlns=\"http://www.w3.org/2000/svg\" class=\"comment-icon\" fill=\"none\"><path fill=\"none\" d=\"M0 0h24v24H0z\" stroke=\"none\"></path><path d=\"M8 9h8\"></path><path d=\"M8 13h6\"></path><path d=\"M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z\"></path></svg>",
        "defaultWidth": "32px",
        "defaultHeight": "32px"
      },
      "styles": {
        "button": {
          "width": "50px",
          "height": "50px",
          "borderRadius": "10px",
          "border": "none",
          "backgroundColor": "transparent",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "cursor": "pointer",
          "padding": "0"
        },
        "icon": {
          "stroke": "#666",
          "transition": "transform 0.2s ease-in-out, stroke 0.2s ease-in-out"
        }
      },
      "hover": {
        "icon": {
          "transform": "scale(1.25)",
          "stroke": "#3b82f6"
        }
      },
      "active": null,
      "animation": {
        "scale": 1.25,
        "duration": "0.2s"
      },
      "colorScheme": {
        "default": "#666",
        "hover": "#3b82f6",
        "active": null
      }
    },
    {
      "type": "like",
      "name": "点赞按钮",
      "tooltip": "点赞",
      "icon": {
        "type": "svg",
        "svg": "<svg class=\"icon\" xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 17.503 15.625\"><path id=\"Fill\" d=\"M8.752,15.625h0L1.383,8.162a4.824,4.824,0,0,1,0-6.762,4.679,4.679,0,0,1,6.674,0l.694.7.694-.7a4.678,4.678,0,0,1,6.675,0,4.825,4.825,0,0,1,0,6.762L8.752,15.624ZM4.72,1.25A3.442,3.442,0,0,0,2.277,2.275a3.562,3.562,0,0,0,0,5l6.475,6.556,6.475-6.556a3.563,3.563,0,0,0,0-5A3.443,3.443,0,0,0,12.786,1.25h-.01a3.415,3.415,0,0,0-2.443,1.038L8.752,3.9,7.164,2.275A3.442,3.442,0,0,0,4.72,1.25Z\"></path></svg>",
        "defaultWidth": "32px",
        "defaultHeight": "32px"
      },
      "styles": {
        "button": {
          "width": "50px",
          "height": "50px",
          "borderRadius": "10px",
          "border": "none",
          "backgroundColor": "transparent",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "cursor": "pointer",
          "padding": "0"
        },
        "icon": {
          "transition": "transform 0.2s linear"
        },
        "iconPath": {
          "fill": "#ccc",
          "transition": "fill 0.2s linear"
        }
      },
      "hover": {
        "icon": {
          "transform": "scale(1.2)"
        },
        "iconPath": {
          "fill": "rgb(177, 139, 189)"
        }
      },
      "active": {
        "iconPath": {
          "fill": "#e74c3c"
        }
      },
      "animation": {
        "scale": 1.2,
        "duration": "0.2s"
      },
      "colorScheme": {
        "default": "#ccc",
        "hover": "rgb(177, 139, 189)",
        "active": "#e74c3c"
      }
    },
    {
      "type": "favorite",
      "name": "收藏按钮",
      "tooltip": "收藏",
      "icon": {
        "type": "svg",
        "svg": "<svg class=\"favorite-icon\" height=\"44\" viewBox=\"0 0 24 24\" width=\"44\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M9.362,9.158c0,0-3.16,0.35-5.268,0.584c-0.19,0.023-0.358,0.15-0.421,0.343s0,0.394,0.14,0.521c1.566,1.429,3.919,3.569,3.919,3.569c-0.002,0-0.646,3.113-1.074,5.19c-0.036,0.188,0.032,0.387,0.196,0.506c0.163,0.119,0.373,0.121,0.538,0.028c1.844-1.048,4.606-2.624,4.606-2.624s2.763,1.576,4.604,2.625c0.168,0.092,0.378,0.09,0.541-0.029c0.164-0.119,0.232-0.318,0.195-0.505c-0.428-2.078-1.071-5.191-1.071-5.191s2.353-2.14,3.919-3.566c0.14-0.131,0.202-0.332,0.14-0.524s-0.23-0.319-0.42-0.341c-2.108-0.236-5.269-0.586-5.269-0.586s-1.31-2.898-2.183-4.83c-0.082-0.173-0.254-0.294-0.456-0.294s-0.375,0.122-0.453,0.294C10.671,6.26,9.362,9.158,9.362,9.158z\"></path></svg>",
        "defaultWidth": "44px",
        "defaultHeight": "44px"
      },
      "styles": {
        "button": {
          "width": "50px",
          "height": "50px",
          "borderRadius": "10px",
          "border": "none",
          "backgroundColor": "transparent",
          "display": "flex",
          "alignItems": "center",
          "justifyContent": "center",
          "cursor": "pointer",
          "padding": "0"
        },
        "icon": {
          "fill": "#666",
          "transition": "transform 0.3s ease, fill 0.3s ease"
        }
      },
      "hover": {
        "icon": {
          "transform": "scale(1.1)"
        }
      },
      "active": {
        "icon": {
          "fill": "#f59e0b"
        }
      },
      "animation": {
        "scale": 1.1,
        "duration": "0.3s"
      },
      "colorScheme": {
        "default": "#666",
        "hover": null,
        "active": "#f59e0b"
      }
    }
  ],
  "commonStyles": {
    "buttonWrapper": {
      "display": "flex",
      "flexDirection": "column",
      "alignItems": "center",
      "cursor": "pointer",
      "position": "relative"
    },
    "count": {
      "fontSize": "13px",
      "color": "#666",
      "marginTop": "4px"
    },
    "tooltip": {
      "position": "absolute",
      "top": "-56px",
      "left": "50%",
      "transform": "translateX(-50%) scaleX(0)",
      "transformOrigin": "left",
      "zIndex": 20,
      "padding": "8px 12px",
      "borderRadius": "8px",
      "border": "1px solid #d1d5db",
      "backgroundColor": "white",
      "fontSize": "14px",
      "fontWeight": "bold",
      "boxShadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
      "transition": "transform 0.3s ease-in-out, opacity 0.3s ease-in-out, visibility 0.3s ease-in-out",
      "whiteSpace": "nowrap",
      "opacity": 0,
      "visibility": "hidden"
    },
    "tooltipHover": {
      "transform": "translateX(-50%) scaleX(1)",
      "opacity": 1,
      "visibility": "visible"
    },
    "actionBar": {
      "marginBottom": "20px",
      "display": "flex",
      "justifyContent": "center",
      "gap": "12px",
      "alignItems": "flex-start"
    }
  },
  "designParameters": {
    "dimensions": {
      "button": "50x50px",
      "icon": {
        "comment": "32x32px",
        "like": "32x32px",
        "favorite": "44x44px"
      },
      "borderRadius": "10px"
    },
    "colors": {
      "comment": {
        "default": "#666",
        "hover": "#3b82f6",
        "active": null
      },
      "like": {
        "default": "#ccc",
        "hover": "rgb(177, 139, 189)",
        "active": "#e74c3c"
      },
      "favorite": {
        "default": "#666",
        "hover": null,
        "active": "#f59e0b"
      }
    },
    "animations": {
      "comment": {
        "scale": 1.25,
        "duration": "0.2s"
      },
      "like": {
        "scale": 1.2,
        "duration": "0.2s"
      },
      "favorite": {
        "scale": 1.1,
        "duration": "0.3s"
      }
    }
  },
  "usage": {
    "vueTemplate": "<div class=\"{type}-btn-wrapper group\"><button class=\"btn {type}-btn\" :class=\"{ active: isActive }\" type=\"button\" @click=\"handleClick\"><!-- SVG icon --></button><span class=\"tooltip\">{tooltip}</span><span class=\"count\">{{ count }}</span></div>",
    "cssRequirements": ["CSS3 transition", "CSS3 transform"],
    "activeClass": "active",
    "hoverTrigger": ".group:hover"
  }
}
